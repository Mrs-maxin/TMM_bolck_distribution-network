# Layout: shared/ (code, data, raw results), paper_standardTMM/, paper_groupedT/, archive/.
# Caches are regenerated from code plus shared/data.
shared/cache/**
!shared/cache/
!shared/cache/README.md
archive/cache/

# Large numerical arrays, pickled models and MC samples stay local.
*.npz
*.npy
*.pkl
*.mat
!shared/data/**
# Per-threshold CDF tables (60 MB or more) are regenerated by the postprocess and split scripts.
**/results/tail_cdf_per_threshold.csv
# case141: per-repeat distribution tables are reproducible; SHA256 kept in run_manifest.json.
archive/result/case141/**/propagation/*.csv
archive/result/case141/*/global_metrics.csv
archive/result/case141/*/quantile_metrics.csv

**/__pycache__/
*.pyc
tmp/
*.asv
*.fig
*.log
*.tmp
.DS_Store

paper_*/02_PAPER/config/author-profile.yaml
archive/combined_paper_20261026/02_PAPER/config/author-profile.yaml

# LaTeX build intermediates; manuscript figures and sources remain tracked.
paper_*/02_PAPER/latex/**/*.aux
paper_*/02_PAPER/latex/*.bbl
paper_*/02_PAPER/latex/*.blg
paper_*/02_PAPER/latex/*.fdb_latexmk
paper_*/02_PAPER/latex/*.fls
paper_*/02_PAPER/latex/*.out
paper_*/02_PAPER/latex/*.toc
paper_*/02_PAPER/latex/*.synctex.gz
paper_*/02_PAPER/latex/main.pdf

# Publisher PDFs stay local; the repository is public.
shared/03_REFERENCE/**/*.pdf
