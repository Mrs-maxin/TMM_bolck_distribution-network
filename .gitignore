# Project-private folders and generated outputs stay off GitHub by default.
cache/**
!cache/
!cache/README.md
result/**
!result/
!result/README.md
!result/*/
!result/*/figures/
!result/*/figures/README.md
# Cloud case141 run: keep tables, figures, manifests and logs; large arrays stay local or in releases.
!result/case141/**
!result/case33bw/**
result/case33bw/**/*.npz
result/case33bw/**/*.npy
result/case141/**/*.npz
result/case141/**/*.npy
02_PAPER/config/author-profile.yaml
tests/**
!tests/
!tests/README.md
!tests/*.m
!tests/python/
!tests/python/**
tests/python/**/__pycache__/
tmp/
*.asv
*.fig
*.mat
!data/
!data/**
*.log
*.tmp

# LaTeX build intermediates; manuscript figures and sources remain tracked.
02_PAPER/latex/*.aux
02_PAPER/latex/**/*.aux
02_PAPER/latex/*.bbl
02_PAPER/latex/*.blg
02_PAPER/latex/*.fdb_latexmk
02_PAPER/latex/*.fls
02_PAPER/latex/*.out
02_PAPER/latex/*.toc
02_PAPER/latex/*.synctex.gz
02_PAPER/latex/main.pdf
